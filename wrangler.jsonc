{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "10x-cards",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3e9eb9ff683346d3adac380f3baa53d6"
    }
  ],
  "observability": {
    "enabled": true
  }
}

