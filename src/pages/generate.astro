---
import Layout from "@/layouts/Layout.astro";
import { GenerationView } from "@/components/views";

// Disable prerendering for this page (dynamic content)
export const prerender = false;

// Protect this route - only authenticated users can access
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/login");
}
---

<Layout title="Generuj fiszki - 10x Cards">
  <GenerationView client:load />
</Layout>
