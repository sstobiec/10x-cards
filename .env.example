# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# OpenRouter AI Configuration
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key

# Development Settings
# Set to "true" to use mock AI service instead of real OpenRouter API
# By default, mock is enabled in development mode (npm run dev)
# USE_MOCK_AI=true

E2E_USERNAME_ID=your_e2e_username_id
E2E_USERNAME=your_e2e_username
E2E_PASSWORD=your_e2e_password